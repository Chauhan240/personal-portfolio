# Copy this file to .env and fill in real values. Never commit .env.
#
# ENVIRONMENT=production makes the API refuse to start if any secret below is missing or weak.
# For local work only, set ENVIRONMENT=development in your own .env.
ENVIRONMENT=production

ADMIN_USERNAME=manish
# Generate with: python scripts/hash_password.py "a-long-unique-passphrase"
ADMIN_PASSWORD_HASH=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (min 32 characters)
JWT_SECRET=

# Admin session lifetime. Short on purpose: it is a single-admin tool.
JWT_EXPIRE_MINUTES=120

# Comma-separated origins allowed to call the API (used for the Origin/CSRF check).
CORS_ORIGINS=https://manish-chauhan.com,https://www.manish-chauhan.com

# Host headers the API accepts. Add your domain; keep localhost for the container health check.
ALLOWED_HOSTS=manish-chauhan.com,www.manish-chauhan.com,localhost,127.0.0.1

DATABASE_PATH=./data/blog.db
